[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/EpisodeSelect.gd" id="1"]

[node name="EpisodeSelect" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.09, 0.09, 0.11, 1)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="TitleLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "EPISODE SELECT"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "도전할 에피소드를 선택하세요"
horizontal_alignment = 1

[node name="EpisodeGrid" type="GridContainer" parent="Center/VBox"]
layout_mode = 2
size_flags_horizontal = 4
columns = 4
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14

[node name="BackButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "모드 선택으로 (ESC)"

[connection signal="pressed" from="Center/VBox/BackButton" to="." method="_on_back_pressed"]
