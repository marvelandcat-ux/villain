[connection signal="pressed" from="HeaderCenter/HeaderVBox/TabRow/GraphicsTabButton" to="." method="_show_tab" binds= ["graphics"]]
[connection signal="pressed" from="HeaderCenter/HeaderVBox/TabRow/AudioTabButton" to="." method="_show_tab" binds= ["audio"]]
[connection signal="pressed" from="HeaderCenter/HeaderVBox/TabRow/ControlsTabButton" to="." method="_show_tab" binds= ["controls"]]
[connection signal="toggled" from="BodyCenter/BodyVBox/GraphicsPanel/FullscreenRow/FullscreenCheck" to="." method="_on_fullscreen_toggled"]
[connection signal="item_selected" from="BodyCenter/BodyVBox/GraphicsPanel/ResolutionOption" to="." method="_on_resolution_selected"]
[connection signal="value_changed" from="BodyCenter/BodyVBox/AudioPanel/VolumeRow/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="pressed" from="BodyCenter/BodyVBox/ControlsPanel/ResetButton" to="." method="_on_reset_pressed"]
[connection signal="pressed" from="BodyCenter/BodyVBox/BackButton" to="." method="_on_back_pressed"]
