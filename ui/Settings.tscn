[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/Settings.gd" id="1"]

[sub_resource type="ButtonGroup" id="ButtonGroup_tabs"]

[node name="Settings" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.09, 0.09, 0.11, 1)

[node name="HeaderCenter" type="CenterContainer" parent="."]
anchor_right = 1.0
offset_top = 20.0
offset_bottom = 150.0

[node name="HeaderVBox" type="VBoxContainer" parent="HeaderCenter"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="TitleLabel" type="Label" parent="HeaderCenter/HeaderVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "설정"
horizontal_alignment = 1

[node name="TabRow" type="HBoxContainer" parent="HeaderCenter/HeaderVBox"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="GraphicsTabButton" type="Button" parent="HeaderCenter/HeaderVBox/TabRow"]
custom_minimum_size = Vector2(150, 60)
layout_mode = 2
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_tabs")
text = "그래픽"

[node name="AudioTabButton" type="Button" parent="HeaderCenter/HeaderVBox/TabRow"]
custom_minimum_size = Vector2(150, 60)
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_tabs")
text = "오디오"

[node name="ControlsTabButton" type="Button" parent="HeaderCenter/HeaderVBox/TabRow"]
custom_minimum_size = Vector2(150, 60)
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_tabs")
text = "조작"

[node name="BodyCenter" type="CenterContainer" parent="."]
anchor_right = 1.0
grow_vertical = 1
offset_top = 150.0
offset_bottom = 150.0

[node name="BodyVBox" type="VBoxContainer" parent="BodyCenter"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="GraphicsPanel" type="VBoxContainer" parent="BodyCenter/BodyVBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="FullscreenRow" type="HBoxContainer" parent="BodyCenter/BodyVBox/GraphicsPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="FullscreenLabel" type="Label" parent="BodyCenter/BodyVBox/GraphicsPanel/FullscreenRow"]
layout_mode = 2
custom_minimum_size = Vector2(100, 0)
text = "전체화면"

[node name="FullscreenCheck" type="CheckButton" parent="BodyCenter/BodyVBox/GraphicsPanel/FullscreenRow"]
layout_mode = 2

[node name="ResolutionRow" type="HBoxContainer" parent="BodyCenter/BodyVBox/GraphicsPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="ResolutionLabel" type="Label" parent="BodyCenter/BodyVBox/GraphicsPanel/ResolutionRow"]
layout_mode = 2
custom_minimum_size = Vector2(100, 0)
text = "해상도"

[node name="ResolutionOption" type="OptionButton" parent="BodyCenter/BodyVBox/GraphicsPanel/ResolutionRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2

[node name="AudioPanel" type="VBoxContainer" parent="BodyCenter/BodyVBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="VolumeRow" type="HBoxContainer" parent="BodyCenter/BodyVBox/AudioPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="VolumeLabel" type="Label" parent="BodyCenter/BodyVBox/AudioPanel/VolumeRow"]
layout_mode = 2
custom_minimum_size = Vector2(100, 0)
text = "마스터 볼륨"

[node name="VolumeSlider" type="HSlider" parent="BodyCenter/BodyVBox/AudioPanel/VolumeRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
max_value = 1.0
step = 0.01
value = 1.0

[node name="VolumeValueLabel" type="Label" parent="BodyCenter/BodyVBox/AudioPanel/VolumeRow"]
layout_mode = 2
custom_minimum_size = Vector2(40, 0)
text = "100%"

[node name="ControlsPanel" type="VBoxContainer" parent="BodyCenter/BodyVBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="SubLabel" type="Label" parent="BodyCenter/BodyVBox/ControlsPanel"]
layout_mode = 2
