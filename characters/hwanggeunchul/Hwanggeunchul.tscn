[node name="Skill1" type="Node" parent="."]
script = ExtResource("8")
cooldown = 10.0
skill_name = "드롭킥"
description = "무릎을 꿇고 잠깐 버틴 뒤(그동안 밀리지 않는다) 앞으로 두 발을 모아 날아 찬다. 맞으면 상대가 멀리 날아가고, 빗나가면 한동안 일어나지 못한다."

[node name="Skill2" type="Node" parent="."]
script = ExtResource("9")
cooldown = 15.0
heal_ratio = 0.3
skill_name = "짜장면 먹기"
description = "주머니에서 짜장면을 꺼내 먹는다. 다 먹으면 잃은 체력의 30%를 회복하지만, 먹을 때마다 대시 쿨타임이 2초씩 늘어난다(라운드 끝까지). 먹다가 맞으면 끊긴다."

[node name="SkillUltimate" type="Node" parent="."]
script = ExtResource("10")
