[node name="SkillUltimate" type="Node" parent="."]
script = ExtResource("9")
cooldown = 22.0
skill_name = "고양이 대작전"
description = "고른 고양이에 따라 다르다. 검은 고양이: 겨드랑이에 끼고 기본공격으로 똥 유탄 5발(범위 피해). 주황 고양이: 고양이 옷을 입고 10초 동안 스킬1, 2를 못 쓰는 대신 기본공격, 체력, 방어, 쿨타임이 좋아진다. 흰 고양이: 10초 동안 흰 고양이를 들고 기본공격이 빠른 할퀴기가 된다"
start_on_cooldown = true
